{
  "name": "@melo/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./exports/index.ts"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "hardhat compile && tsc --noEmit",
    "export": "hardhat compile && node scripts/export.ts",
    "deploy:arc": "node --env-file-if-exists=.env node_modules/hardhat/dist/src/cli.js run scripts/deploy.ts --network arcTestnet",
    "deploy:base": "node --env-file-if-exists=.env node_modules/hardhat/dist/src/cli.js run scripts/deploy.ts --network baseSepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.4",
    "hardhat": "^3.18.0",
    "typescript": "~6.0.3",
    "viem": "^2.57.1"
  }
}
