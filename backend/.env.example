# Copy to .env (gitignored). Never commit real values.
DATABASE_URL=postgres://localhost:54329/melo
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Privy dashboard > App settings. The app ID and verification key are public.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# Server-only. Used to look up a user's embedded wallet address.
PRIVY_APP_SECRET=
PAYCREST_BASE_URL=https://api.paycrest.io/v2
# Sender dashboard credentials (mainnet only). The API Secret verifies webhook signatures;
# point the dashboard webhook URL at https://<public-host>/v1/webhooks/paycrest.
PAYCREST_API_KEY=
PAYCREST_API_SECRET=
# Base address Paycrest refunds unpaid orders to (defaults to ESCROW_PAYEE_ADDRESS).
PAYCREST_REFUND_ADDRESS=

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

FRESH_AUTH_SECONDS=300
BANK_CHANGE_COOLDOWN_HOURS=24

# Quotes and deposits
QUOTE_TTL_SECONDS=180
MELO_FEE_BPS=30
# Testnet only: must be the escrow's quoteSigner. Production keys live in a KMS, never here.
QUOTE_SIGNER_PRIVATE_KEY=
# Receives released escrow funds (MELO treasury)
ESCROW_PAYEE_ADDRESS=
DEPOSIT_REFUND_DELAY_MINUTES=120

# Payouts: simulated | paycrest. Paycrest has no testnet: `paycrest` places real orders.
PAYOUT_PROVIDER=simulated
# REAL FUNDS. MELO treasury on Base mainnet that pays Paycrest orders (USDC float + a little ETH
# for gas). Generate a fresh key; never reuse a key that was ever shared. KMS in production.
TREASURY_PRIVATE_KEY=
# off: orders are created but never funded (they expire, escrow refunds). on: treasury pays them.
PAYOUT_FUNDING=off
PAYOUT_FUNDING_MAX_USDC=5
# RPC settings take a comma-separated list; later URLs are fallbacks.
BASE_RPC_URL=https://mainnet.base.org,https://base-rpc.publicnode.com
SIM_PAYOUT_SECONDS=15
# succeeded → escrow released to ESCROW_PAYEE_ADDRESS; failed → refunded to the depositor
SIM_PAYOUT_OUTCOME=succeeded
# Testnet only: signs payout outcomes for settle(). Production attestors live in a KMS, never here.
ATTESTOR_PRIVATE_KEY=
ARC_MAINNET_RPC_URL=https://arc.drpc.org,https://rpc.mainnet.arc.io,https://rpc.quicknode.mainnet.arc.io
# Deposit networks to serve: 5042 (Arc mainnet) for production; leave commented out for the testnets.
# DEPOSIT_CHAIN_IDS=5042
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
